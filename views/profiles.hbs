<link rel="stylesheet" href="https://code.jquery.com/ui/1.14.2/themes/base/jquery-ui.css">
<script src="https://code.jquery.com/jquery-3.7.1.js"></script>
<script src="https://code.jquery.com/ui/1.14.2/jquery-ui.js"></script>

<div class="add-profile-panel">
    <h4>Додати та налаштувати профіль</h4>
    <input type="text" placeholder="Назва профіля" id="profile-name">
    <input type="text" placeholder="Опис" id="profile-description">
    <div class="option-block">
        <label for="amount-temperature">Температура повітря:</label>
        <input type="text" id="amount-temperature" readonly="">
        <div id="slider-range-temperature"></div>
        <input type="number" placeholder="Пріорітет" class="profile-priority" id="profile-priority-temperature" min="0.1" max="0.9" step="0.1">
    </div>
    <div class="option-block">
        <label for="amount-humidity">Відносна вологість повітря:</label>
        <input type="text" id="amount-humidity" readonly="">
        <div id="slider-range-humidity"></div>
        <input type="number" placeholder="Пріорітет" class="profile-priority" id="profile-priority-humidity" min="0.1" max="0.9" step="0.1">
    </div>
    <div class="option-block">
        <label for="amount-C02-Emissions">Свіжість повітря (макс. рівень CO<sub>2</sub>)</label>
        <input type="text" id="amount-C02-Emissions" readonly="">
        <div id="slider-range-C02-Emissions"></div>
        <input type="number" placeholder="Пріорітет" class="profile-priority" id="profile-priority-C02-Emissions" min="0.1" max="0.9" step="0.1">
    </div>
    <p align="justify">Примітка: коефіцієнт чутливості варіюється від 0.1 (найменш чутливий) до 0.9 (найбільш чутливий).</p>
    <div class="profile-panel-buttons-wrapper">
        <button class="dashboard-button" onclick="addProfile()">Додати</button>
        <button class="dashboard-button" onclick="closeTab()">Скасувати</button>
    </div>
</div>
<h1>{{header}}</h1>
<hr>
<div id="content">
    <div class="tools">
        <button class="dashboard-button" onclick="openTab()">Додати профіль +</button>
    </div>
    <div class="profiles"></div>
</div>

</div>

<script src="setupProfiles.js" type="text/javascript"></script>