<h1>{{header}}</h1>
<hr>
<div id="content">
    <b>Статус з`єднання:</b>
    <p id="connection-status">З'єднання з модулем не встановлено</p>
    <b>Режим:</b>
    <br>
    <span>
        <input type="radio" name="mode-type" id="radio-mode-1" onclick="setupMode('off-line')">
        <label for="radio-mode-1">Автономний</label><br>
    </span>
    <span>
        <input type="radio" name="mode-type" id="radio-mode-2" onclick="setupMode('handheld')">
        <label for="radio-mode-2">Ручний</label>
    </span>
</div>

<style>
    span {
        display: flex;
        align-items: center;
        height: 40px;
        margin: 10px 0;
    }

    input {
        opacity: 0;
        width: 30px;
        height: 30px;
        margin-right: 10px;
    }

    label::before {
        content: "";
        background-image: url("/images/radio.png");
        position: absolute;
        width: 30px;
        height: 30px;
        background-size: cover;
        margin-left: -40px;
        margin-top: -2px;
    }

    input:checked+label::before {
        background-image: url("/images/radio-checked.png");
    }
</style>

<script src="setupSettings.js" type="text/javascript"></script>